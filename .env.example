# Bu dosyanın adını ".env" yapın (kur.bat bunu sizin için yapar).

# Hangi yapay zeka: otomatik (önce Ollama, olmazsa Gemini), ollama, gemini
YZ_SAGLAYICI=otomatik

# --- Ollama: bilgisayarınızda çalışır, ücretsiz ve sınırsız ---
# 16 GB RAM veya 8 GB ekran kartı: qwen3.5:9b   (önerilen)
# 8 GB RAM / zayıf bilgisayar:      qwen3.5:4b
# 32 GB+ RAM veya güçlü ekran kartı: qwen3.5:27b (en zeki, yavaş)
OLLAMA_MODEL=qwen3.5:9b
# Model cevap vermeden önce düşünsün mü (1 = daha zeki ama daha yavaş)
YZ_DUSUNME=0

# --- Gemini: yedek, ücretsiz ama günlük limitli ---
# Anahtar: https://aistudio.google.com/apikey  (boş bırakılabilir)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Genel ---
SEHIR=İstanbul
JARVIS_SES=tr-TR-AhmetNeural
# Kadın sesi için: tr-TR-EmelNeural

# 1 yaparsanız silme/kapatma gibi işlemlerde onay sormaz (dikkat!)
JARVIS_TAM_YETKI=0
