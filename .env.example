# Bu dosyanın adını ".env" yapın ve doldurun.

# Ücretsiz anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# İsteğe bağlı
GEMINI_MODEL=gemini-flash-latest
SEHIR=İstanbul
JARVIS_SES=tr-TR-AhmetNeural
# Kadın sesi için: tr-TR-EmelNeural

# 1 yaparsanız silme/kapatma gibi işlemlerde onay sormaz (dikkat!)
JARVIS_TAM_YETKI=0
