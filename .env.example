# Bu dosyanın adını ".env" yapın (kur.bat bunu sizin için yapar).

# --- Ollama (yapay zeka bilgisayarınızda çalışır; buluta veri gitmez) ---
OLLAMA_ADRES=http://127.0.0.1:11434
# Ana model. Donanımınıza göre seçin; "python -m jarvis_core.saglik" donanımı gösterir.
#   8 GB ekran kartı veya 16 GB RAM : qwen3.5:9b
#   daha zayıf bilgisayar           : qwen3.5:4b
OLLAMA_MODEL=qwen3.5:9b
# İsteğe bağlı ayrı modeller (boşsa ana model kullanılır)
OLLAMA_MODEL_KOD=
OLLAMA_MODEL_GORSEL=
# 1: aynı anda tek model bellekte tutulur (az bellekli bilgisayarlar için)
OLLAMA_TEK_MODEL=1
# Bağlam uzunluğu (token). Büyük değer daha çok bellek ister.
OLLAMA_BAGLAM=16384
# Bir model yanıtı için en fazla bekleme (saniye)
OLLAMA_ZAMAN_ASIMI=300
# 1: model cevap vermeden önce düşünür (daha iyi plan, daha yavaş)
YZ_DUSUNME=0

# --- Görev sınırları ---
GOREV_MAX_ADIM=20
GOREV_MAX_SURE=900
GOREV_TEKRAR_SINIRI=3

# --- Ses ---
# Varsayılan: tamamen yerel (faster-whisper ses tanıma + Piper Türkçe ses). Modelleri indirmek için:
#   python -m jarvis_core.audio.kur
# 1 yaparsanız yerel sağlayıcı yokken Google ses tanıma ve Microsoft Edge sesi kullanılır:
# konuşmanız ve cevaplar internete gider.
JARVIS_SES_CEVRIMICI=0
# Ses tanıma modeli: tiny / base / small / medium (büyük = daha doğru, daha yavaş). ".en" modelleri Türkçe bilmez.
JARVIS_STT_MODEL=small
# Çevrimiçi Edge sesi (yalnız JARVIS_SES_CEVRIMICI=1 iken)
JARVIS_SES=tr-TR-AhmetNeural

# --- Genel ---
SEHIR=İstanbul
JARVIS_ACIL_KISAYOL=ctrl+alt+end
